.venv/
.venv_ready
__pycache__/
*.py[cod]
.pytest_cache/
workspace/projects/*
!workspace/projects/.gitkeep
workspace/tmp/*
!workspace/tmp/.gitkeep
smoke_test_output/
*.log

# SDD scratch and local temp
.superpowers/
workspace/tmp/*
!workspace/tmp/.gitkeep

# MCU firmware deliverables produced by tests/controller runs (never commit binaries)
workspace/deliverables/

# Per-machine files generated by 01_INSTALL.bat -- contain local paths and hardware IDs
runtime/environment_report.json
runtime/runtime_config.json

# Claude Code per-machine settings
.claude/

# Per-machine IDE state (Nuvoton/CMSIS extension tasks hard-wired to local folders)
.vscode/

# Working copies unzipped next to the collection-firmware ZIPs; the ZIPs are the deliverable
1_Collect_Firmware_bin/*/*/

# Where scripts\download_arm_toolchain.py unpacks the toolchain (about 1.2 GB, 8,332 files),
# the archive it downloads (--keep-zip), and its staging folders and lock file while it installs.
runtime/arm-gnu-toolchain*/
runtime/arm-gnu-toolchain-*.zip*
runtime/.tc-new-*/
runtime/.tc-old-*/
runtime/.tc-lock

# Arm GNU Toolchain installers are ~200 MB: over GitHub's 100 MB per-file limit.
# Students install it with scripts\download_arm_toolchain.py (see 使用手冊 6.2).
/2_Compiler and Download Tool Driver/arm-gnu-toolchain-*
